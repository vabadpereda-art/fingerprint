FROM debian:12

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential \
    clang \
    cmake \
    curl \
    git \
    libssl-dev \
    pkg-config \
    python3 \
    python3-pip \
    openjdk-17-jdk \
    libudev-dev \
    libusb-1.0-0-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN curl https://sh.rustup.rs -sSf | sh -s -- -y --profile minimal
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /app
COPY . /app

RUN cargo build --release -p zkfp-capi \
    && mkdir -p /out \
    && find /app/target/release -maxdepth 1 \( -name 'libzkfp_capi.so' -o -name 'libzkfp_capi.a' -o -name 'zkfp_capi.dll' -o -name 'libzkfp_capi.dylib' \) -exec cp {} /out/ \;

CMD ["bash"]
